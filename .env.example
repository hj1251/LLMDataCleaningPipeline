# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQL Server — leave blank to run the pipeline against the bundled demo data in sample_data/
SQL_SERVER=
SQL_DATABASE=
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Batching / concurrency
BATCH_SIZE=50
SMALL_BATCH=10
MAX_RETRY=1
MAX_WORKERS=2

# ERP export validation
MAX_DESCRIPTION_LENGTH=40

# Optional path overrides (defaults point at sample_data/)
DEMO_CATALOGUE_PATH=
EXISTING_ITEMS_PATH=
